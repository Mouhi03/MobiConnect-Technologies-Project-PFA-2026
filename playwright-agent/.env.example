# Copy this file to ".env" and fill in your real values. Never commit ".env".

PORT=4000

# SureMDM Hub (the portal where you create new customers)
SUREMDM_HUB_URL=https://your-hub-url.suremdm.com
SUREMDM_USERNAME=your_hub_login
SUREMDM_PASSWORD=your_hub_password

# true = run the browser invisibly (normal use)
# false = watch the browser open and click things (use this while adjusting selectors)
HEADLESS=true
